# Added: TASMail environment variable template (TMAIL-40)
# PURPOSE: Copy to /etc/tasmail/tasmail.env and fill in production values.
#          The backend reads these via Config::from_env() on startup.
# SECURITY: This file contains secrets — restrict permissions to root:tasmail 640.

# =============================================================================
# Server
# =============================================================================
# Added: Bind address — use 127.0.0.1 when behind Nginx reverse proxy
TASMAIL_HOST=127.0.0.1
TASMAIL_PORT=3000

# =============================================================================
# Database (PostgreSQL 16+)
# =============================================================================
# Added: PostgreSQL connection string — migrations run automatically on startup
DATABASE_URL=postgres://tasmail:CHANGE_ME_STRONG_PASSWORD@localhost/tasmail
DATABASE_MAX_CONNECTIONS=20

# =============================================================================
# IMAP (Dovecot)
# =============================================================================
# Added: IMAP is the source of truth for mail data — backend proxies to Dovecot
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_TLS=true
# Added: Optional master password for Dovecot master user authentication
# IMAP_MASTER_PASSWORD=

# =============================================================================
# SMTP (Postfix)
# =============================================================================
# Added: Outbound mail submission via Postfix
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_TLS=true

# =============================================================================
# JWT Authentication
# =============================================================================
# Added: REQUIRED — generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
# Added: Token expiry in seconds (defaults: access=900/15min, refresh=604800/7days)
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# =============================================================================
# Attachment Storage
# =============================================================================
# Added: Directory for uploaded attachments — must be writable by tasmail user
ATTACHMENT_DIR=/var/lib/tasmail/attachments
MAX_FILE_SIZE=26214400
# Added: Optional ClamAV socket for virus scanning on upload
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# =============================================================================
# CORS
# =============================================================================
# Added: Allowed origin for CORS — set to your frontend domain
CORS_ORIGIN=https://mail.example.com

# =============================================================================
# Logging
# =============================================================================
# Added: Set to "json" for structured logging (useful for log aggregation)
LOG_FORMAT=json
# Added: Rust log level filter
RUST_LOG=tasmail=info,tower_http=info

# =============================================================================
# Rspamd Spam Filtering
# =============================================================================
# Added: Rspamd HTTP API for spam score checking before delivery
# RSPAMD_URL=http://127.0.0.1:11333
# RSPAMD_PASSWORD=

# =============================================================================
# Ollama Local LLM
# =============================================================================
# Added: Optional local LLM for smart reply suggestions and email summarization
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# =============================================================================
# Metrics
# =============================================================================
# Added: Bearer token for /api/metrics endpoint (Prometheus scraping)
# METRICS_TOKEN=CHANGE_ME_METRICS_SECRET

# =============================================================================
# Payment Providers (Billing — TMAIL-46)
# =============================================================================
# TASMail uses the SAME four payment providers as PayPro OMS for billing parity.
# Source the same credential values that are configured in PayPro's
# `payment_provider_config` PostgreSQL table (or PayPro application.yml).
# Providers without credentials are silently disabled; only configure the ones you use.

# --- Paystack (card + Mobile Money via Paystack, West Africa) ---
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...
# PAYSTACK_BASE_URL=https://api.paystack.co

# --- Mastercard Payment Gateway Services (MPGS, e.g. via GTBank Ghana) ---
# MASTERCARD_MERCHANT_ID=...
# MASTERCARD_API_PASSWORD=...
# MASTERCARD_GATEWAY_URL=https://eu-gateway.mastercard.com/api/rest/version/61
# MASTERCARD_CURRENCY=GHS
# MASTERCARD_WEBHOOK_SECRET=...

# --- Cybersource Invoicing ---
# CYBERSOURCE_MERCHANT_ID=gh_tech_at_scale       # PayPro production value
# CYBERSOURCE_KEY_ID=...
# CYBERSOURCE_SECRET_KEY=...                      # base64-encoded shared secret
# CYBERSOURCE_BASE_URL=https://apitest.cybersource.com   # or https://api.cybersource.com for prod

# --- Bank Transfer (manual) ---
# BANK_NAME=GTBank Ghana
# BANK_ACCOUNT_NAME=Tech at Scale Ltd
# BANK_ACCOUNT_NUMBER=1234567890
# BANK_BRANCH=Accra Main
# BANK_SWIFT_CODE=GTBIGHAC
# BANK_REFERENCE_PREFIX=TASMAIL

# =============================================================================
# Backups (TMAIL-42)
# Daily backup.sh + weekly backup-verify.sh systemd timers. See docs/BACKUP-RESTORE.md.
# =============================================================================
# Retention window in days for all backup artefacts (default 30)
# BACKUP_RETENTION_DAYS=30
#
# Off-site target: none | rclone | rsync. Default is none — local-only backups.
# BACKUP_OFFSITE_TYPE=rclone
# BACKUP_OFFSITE_DEST=tasmail-offsite:tasmail-backups   # rclone remote:path OR rsync user@host:path
# BACKUP_OFFSITE_OPTS=--s3-server-side-encryption=AES256
#
# Verification sandbox DB (auto-created/dropped by backup-verify.sh).
# BACKUP_VERIFY_SANDBOX_DB=tasmail_backup_verify
# BACKUP_VERIFY_DB_RESTORE=1   # set to 0 to skip the sandbox restore step

# =============================================================================
# Notification SMTP (system-originated mail: billing receipts, OTP, password resets)
# =============================================================================
# Defaults to noreply@techatscale.io. Override SMTP_NOTIFICATION_FROM if your
# deployment sends from a different mailbox.
# SMTP_NOTIFICATION_FROM=noreply@techatscale.io
# SMTP_NOTIFICATION_USERNAME=noreply@techatscale.io
# SMTP_NOTIFICATION_PASSWORD=...
