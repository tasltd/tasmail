# Added: PostgreSQL lookup for virtual alias maps (TMAIL-11)
# Postfix queries this to resolve email aliases/forwards to destination addresses.
# Install to: /etc/postfix/pgsql-virtual-alias-maps.cf
# Permissions: chmod 640, chown root:postfix

# Added: Database connection settings — replace placeholders before deploying
hosts = __DB_HOST__
dbname = __DB_NAME__
user = __DB_USER__
password = __DB_PASS__

# Added: Query returns the destination address for active aliases
# %s is replaced by the full source email address
query = SELECT destination_address FROM aliases WHERE source_address = '%s' AND active = true
