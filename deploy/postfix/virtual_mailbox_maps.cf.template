# Added: PostgreSQL lookup for virtual mailbox maps (TMAIL-11)
# Postfix queries this to verify a recipient mailbox exists before accepting delivery.
# Install to: /etc/postfix/pgsql-virtual-mailbox-maps.cf
# Permissions: chmod 640, chown root:postfix

# Added: Database connection settings — replace placeholders before deploying
hosts = __DB_HOST__
dbname = __DB_NAME__
user = __DB_USER__
password = __DB_PASS__

# Added: Query returns 1 if the mailbox exists and is active
# %s is replaced by the full email address (e.g., user@example.com)
query = SELECT 1 FROM mailboxes WHERE username = '%s' AND active = true
