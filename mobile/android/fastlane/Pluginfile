# Huawei AppGallery upload lane — critical for the Ghana market where many
# Honor/Huawei devices ship without Google Play services.
# https://github.com/karumi/fastlane-plugin-huawei_appgallery_connect
gem 'fastlane-plugin-huawei_appgallery_connect'

# Generate fastlane changelogs from git commits on the release branch.
gem 'fastlane-plugin-changelog'

# Pretty-print build summaries in CI logs.
gem 'fastlane-plugin-versioning_android'
